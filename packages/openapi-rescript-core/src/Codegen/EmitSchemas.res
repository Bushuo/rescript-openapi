let baseHeader = [
  "// Generated by openapi-rescript-core.",
  "",
  "type t<'value> = Client.schema<'value>",
  "type field = OpenapiRescriptRuntime.Schema.field",
  "",
  "let field = OpenapiRescriptRuntime.Schema.makeField",
  "let string: t<string> = OpenapiRescriptRuntime.Schema.string",
  "let integer: t<int> = OpenapiRescriptRuntime.Schema.integer",
  "let number: t<float> = OpenapiRescriptRuntime.Schema.number",
  "let boolean: t<bool> = OpenapiRescriptRuntime.Schema.boolean",
  "let array = OpenapiRescriptRuntime.Schema.array",
  "let object_ = OpenapiRescriptRuntime.Schema.object_",
]

let renderEnumSchema = (
  ~name: string,
  ~enumMode: Ir.enumMode,
  values: array<string>,
): array<string> => {
  let decodeLines = Belt.Array.concat(
    Array.map(values, value =>
      "    | " ++
      Printer.quote(value) ++
      " => Ok(" ++
      Printer.enumConstructor(~qualifiedModels=true, value) ++
      ")"
    ),
    [
      switch enumMode {
      | Ir.Open => "    | value => Ok(" ++ Printer.enumUnknown(~qualifiedModels=true, "value") ++ ")"
      | Ir.Closed => "    | value => " ++ Printer.enumDecodeErrorExpr("value", values)
      },
    ],
  )
  let encodeLines = Belt.Array.concat(
    Array.map(values, value =>
      "    | " ++
      Printer.enumConstructor(~qualifiedModels=true, value) ++
      " => " ++
      Printer.quote(value)
    ),
    switch enumMode {
    | Ir.Open => ["    | " ++ Printer.enumUnknown(~qualifiedModels=true, "value") ++ " => value"]
    | Ir.Closed => []
    },
  )

  Belt.Array.concatMany([
    [
      "let " ++
      Printer.typeName(name) ++
      ": t<" ++
      Printer.enumTypeRef(~qualifiedModels=true, name) ++
      "> = stringMapped(",
      "  ~decode=value =>",
      "    switch value {",
    ],
    decodeLines,
    [
      "    },",
      "  ~encode=value =>",
      "    switch value {",
    ],
    encodeLines,
    [
      "    },",
      ")",
    ],
  ])
}

let emitSchema = (schema: Ir.namedSchema, ~enumMode: Ir.enumMode): array<string> =>
  switch schema.schema {
  | Ir.Object(fields) =>
    let fieldLines = Array.map(fields, field =>
      "  field(~name=" ++
      Printer.quote(field.name) ++
      ", ~required=" ++
      Printer.boolLiteral(field.required) ++
      ", " ++
      Printer.schemaExpr(field.schema) ++ "),"
    )

    Belt.Array.concatMany([
      [
        "let " ++
        Printer.typeName(schema.name) ++
        ": t<Models." ++
        Printer.typeName(schema.name) ++ "> = object_([",
      ],
      fieldLines,
      ["])"],
    ])
  | Ir.StringEnum({values, _}) => renderEnumSchema(~name=schema.name, ~enumMode, values)
  | value => [
      "let " ++
      Printer.typeName(schema.name) ++
      ": t<Models." ++
      Printer.typeName(schema.name) ++
      "> = " ++
      Printer.schemaExpr(value),
    ]
  }

let emit = (document: Ir.document, ~enumMode: Ir.enumMode): Printer.file => {
  let header = if Array.some(document.schemas, schema =>
    switch schema.schema {
    | Ir.StringEnum(_) => true
    | _ => false
    }
  ) {
    Belt.Array.concat(baseHeader, ["let stringMapped = OpenapiRescriptRuntime.Schema.stringMapped"])
  } else {
    baseHeader
  }
  let definitions = ref([])

  Array.forEachWithIndex(document.schemas, (schema, index) => {
    if index > 0 {
      definitions.contents = Belt.Array.concat(definitions.contents, [""])
    }

    definitions.contents = Belt.Array.concat(definitions.contents, emitSchema(schema, ~enumMode))
  })

  let lines = if Array.length(definitions.contents) == 0 {
    header
  } else {
    Belt.Array.concatMany([header, [""], definitions.contents])
  }

  Printer.makeFile(~path="Schemas.res", ~lines)
}
