let header = [
  "// Generated by openapi-rescript-core.",
  "",
]

let renderField = (~quoteLabels: bool, field: Ir.objectField): string =>
  Printer.indentLine(
    ~level=1,
    Printer.recordLabel(~quoteAll=quoteLabels, field.name)
    ++ ": "
    ++ (
      if field.required {
        Printer.modelType(field.schema)
      } else {
        "option<" ++ Printer.modelType(field.schema) ++ ">"
      }
    )
    ++ ",",
  )

let renderSchema = (schema: Ir.namedSchema): array<string> =>
  switch schema.schema {
  | Ir.Object(fields) =>
    let quoteLabels = Printer.shouldQuoteRecordLabels(Belt.Array.map(fields, field => field.name))

    Belt.Array.concatMany([
      ["type " ++ Printer.typeName(schema.name) ++ " = {"],
      Belt.Array.map(fields, field => renderField(~quoteLabels, field)),
      ["}"],
    ])
  | value => ["type " ++ Printer.typeName(schema.name) ++ " = " ++ Printer.modelType(value)]
  }

let emit = (document: Ir.document): Printer.file => {
  let definitions = ref([])

  Belt.Array.forEachWithIndex(document.schemas, (index, schema) => {
    if index > 0 {
      definitions.contents = Belt.Array.concat(definitions.contents, [""])
    }

    definitions.contents = Belt.Array.concat(definitions.contents, renderSchema(schema))
  })

  Printer.makeFile(~path="Models.res", ~lines=Belt.Array.concat(header, definitions.contents))
}
