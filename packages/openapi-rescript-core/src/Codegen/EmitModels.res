let header = ["// Generated by openapi-rescript-core.", ""]

let renderField = (~quoteLabels: bool, field: Ir.objectField): string =>
  Printer.indentLine(
    ~level=1,
    Printer.recordLabel(~quoteAll=quoteLabels, field.name) ++
    ": " ++
    Printer.objectFieldModelType(field) ++
    ",",
  )

let renderEnum = (~name: string, ~enumMode: Ir.enumMode, values: array<string>): array<string> => {
  let constructorLines = Array.map(values, value =>
    Printer.indentLine(~level=1, "| " ++ Printer.enumConstructor(value))
  )
  let unknownLine = switch enumMode {
  | Ir.Open => [Printer.enumUnknownVariantLine(~level=1)]
  | Ir.Closed => []
  }

  Belt.Array.concatMany([
    ["type " ++ Printer.enumTypeRef(name) ++ " ="],
    constructorLines,
    unknownLine,
  ])
}

let renderRecordType = (~name: string, fields: array<Ir.objectField>): array<string> => {
  let quoteLabels = Printer.shouldQuoteRecordLabels(Array.map(fields, field => field.name))

  Belt.Array.concatMany([
    ["type " ++ Printer.typeName(name) ++ " = {"],
    Array.map(fields, field => renderField(~quoteLabels, field)),
    ["}"],
  ])
}

let unionPayloadTypeName = (~unionName: string, ~tag: string): string =>
  unionName ++ Naming.enumConstructorName(tag)

let renderUnion = (~name: string, cases: array<Ir.unionCase>): array<string> => {
  let payloadTypeBlocks = ref([])

  let constructorLines = Array.map(cases, case_ =>
    switch case_.payload {
    | Ir.Object(fields) if Array.length(fields) == 0 =>
      Printer.indentLine(~level=1, "| " ++ Printer.enumConstructor(case_.tag))
    | Ir.Object(fields) =>
      let payloadTypeName = unionPayloadTypeName(~unionName=name, ~tag=case_.tag)
      payloadTypeBlocks.contents = Belt.Array.concat(
        payloadTypeBlocks.contents,
        [renderRecordType(~name=payloadTypeName, fields)],
      )
      Printer.indentLine(
        ~level=1,
        "| " ++ Printer.enumConstructor(case_.tag) ++ "(" ++ Printer.typeName(payloadTypeName) ++ ")",
      )
    | _ =>
      Printer.indentLine(
        ~level=1,
        "| " ++
        Printer.enumConstructor(case_.tag) ++
        "(" ++
        Printer.modelType(case_.payload) ++
        ")",
      )
    }
  )

  let unionLines = Belt.Array.concat(["type " ++ Printer.typeName(name) ++ " ="], constructorLines)

  if Array.length(payloadTypeBlocks.contents) == 0 {
    unionLines
  } else {
    let payloadLines = Belt.Array.joinWith(
      Array.map(payloadTypeBlocks.contents, lines => Belt.Array.joinWith(lines, "\n", line => line)),
      "\n\n",
      block => block,
    )->String.split("\n")

    Belt.Array.concatMany([payloadLines, [""], unionLines])
  }
}

let renderSchema = (
  schema: Ir.namedSchema,
  ~enumMode: Ir.enumMode,
): array<string> =>
  switch schema.schema {
  | Ir.Object(fields) =>
    renderRecordType(~name=schema.name, fields)
  | Ir.StringEnum({values, _}) => renderEnum(~name=schema.name, ~enumMode, values)
  | Ir.DiscriminatedUnion({cases, _}) =>
    renderUnion(~name=schema.name, cases)
  | Ir.Nullable(Ir.DiscriminatedUnion({cases, _})) =>
    let valueTypeName = schema.name ++ "Value"

    Belt.Array.concatMany([
      renderUnion(~name=valueTypeName, cases),
      [""],
      [
        "type " ++
        Printer.typeName(schema.name) ++
        " = Null.t<" ++
        Printer.typeName(valueTypeName) ++
        ">",
      ],
    ])
  | value => [
      "type " ++
      Printer.typeName(schema.name) ++
      " = " ++
      Printer.modelType(value),
    ]
  }

let emit = (document: Ir.document, ~enumMode: Ir.enumMode): Printer.file => {
  let definitions = ref([])
  let orderedSchemas = SchemaOrder.orderSchemas(document.schemas)

  Array.forEachWithIndex(orderedSchemas, (schema, index) => {
    if index > 0 {
      definitions.contents = Belt.Array.concat(definitions.contents, [""])
    }

    definitions.contents = Belt.Array.concat(
      definitions.contents,
      renderSchema(schema, ~enumMode),
    )
  })

  Printer.makeFile(~path="Models.res", ~lines=Belt.Array.concat(header, definitions.contents))
}
